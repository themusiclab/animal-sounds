@article{downer-bartholomew_female_2022,
	title = {Female preference for color-enhanced males: a test of the sensory bias model in medaka, a drab fish},
	volume = {33},
	copyright = {https://academic.oup.com/journals/pages/open\_access/funder\_policies/chorus/standard\_publication\_model},
	issn = {1045-2249, 1465-7279},
	shorttitle = {Female preference for color-enhanced males},
	url = {https://academic.oup.com/beheco/article/33/1/252/6431784},
	doi = {10.1093/beheco/arab131},
	abstract = {Abstract
            Sexual selection research has long focused on the evolution of female mate preferences. Most of the models that have been developed posit that mate preferences evolve in a mating context. In contrast, the sensory bias model proposes that mate choice preferences arise in a non-mating context, as a by-product of natural selection acting on a female’s perceptual system. Recent research has shown that many species of fishes, from across a large clade including poeciliids, goodeids, and medaka, have a bias for long wavelength (LW) colors (yellow, orange, red) in a non-mating context. Even species that do not have LW-colored ornaments, apparently because they have been lost secondarily, retain this latent bias for LW colors. Here, we predicted that female Oryzias latipes (Japanese medaka), a drab species with a latent preference for LW colors, would show a mate choice preference for males with an artificial secondary sexual trait—a colored stripe added to their flank. We confirmed that females were more responsive to red and orange objects in a non-mating context than to other colors. We also showed that females were less resistant towards males with an LW-colored stripe than to those enhanced with a non-LW stripe and that, for many females, responses towards specific LW colors were consistent across these non-mating and mating contexts. Therefore, our results provide support for the sensory bias model by providing a link between a sensory bias in a non-mating context and a mate choice preference in a drab species like medaka.},
	language = {en},
	number = {1},
	urldate = {2024-11-08},
	journal = {Behavioral Ecology},
	author = {Downer-Bartholomew, Benjamin M B and Rodd, F Helen},
	editor = {Herberstein, Marie},
	month = feb,
	year = {2022},
	pages = {252--262},
	file = {Full Text:C\:\\Users\\smith\\Zotero\\storage\\4Q8T2MVL\\Downer-Bartholomew and Rodd - 2022 - Female preference for color-enhanced males a test.pdf:application/pdf},
}

@article{rosenstein_birdsong_2024,
	title = {Birdsong complexity and preference: {The} role of birdwatching expertise},
	issn = {1063-1119, 1568-5306},
	shorttitle = {Birdsong {Complexity} and {Preference}},
	url = {https://brill.com/view/journals/soan/aop/article-10.1163-15685306-bja10206/article-10.1163-15685306-bja10206.xml},
	doi = {10.1163/15685306-bja10206},
	abstract = {This study examined the influence of birdsong complexity (melodic and rhythmic) on the preferences of primarily older, White Americans and whether individual differences and acquired experience moderate this relationship. An anonymous, online survey presented recordings of 11 anonymous birdsongs followed by a series of questions. Respondents (N = 209) were unpaid volunteers, recruited from a variety of sources. Using a mixed model analysis, the study found a positive linear relationship between both forms of complexity and preference. The relationship between rhythmic complexity and preference became curvilinear when birdwatching expertise was a moderator. Birdwatchers tended to show a greater preference for birdsong than non-birdwatchers over the entire range of rhythmic complexity, but particularly at the highest levels. Future research should focus on the types of information embedded within birdsongs and the ways in which they are interpreted by humans.},
	language = {en},
